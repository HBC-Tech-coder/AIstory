\set ON_ERROR_STOP on

-- Package-owned adjunct entrypoint. Verify the package and SQL SHA before use.
-- Domain SQL and exact four-column bookkeeping commit together; no ledger repair.
begin;
set local search_path = pg_catalog;
set local check_function_bodies = on;
set local plpgsql.extra_errors = 'shadowed_variables';
select pg_catalog.pg_advisory_xact_lock(20260831, 113000);
lock table supabase_migrations.schema_migrations in share row exclusive mode;

do $first_change_ledger_preflight$
declare
  v_ledger oid := pg_catalog.to_regclass('supabase_migrations.schema_migrations');
  v_columns jsonb;
begin
  if session_user is distinct from 'postgres' or current_user is distinct from 'postgres'
    or (select pg_catalog.pg_get_userbyid(datdba) from pg_catalog.pg_database
      where datname=pg_catalog.current_database()) is distinct from 'postgres'
    or not exists(select 1 from pg_catalog.pg_class where oid=v_ledger and relkind='r'
      and relpersistence='p' and pg_catalog.pg_get_userbyid(relowner)='postgres') then
    raise exception 'First-change exact ledger owner unavailable' using errcode='55000';
  end if;
  select jsonb_agg(jsonb_build_array(a.attnum,a.attname,pg_catalog.format_type(a.atttypid,a.atttypmod),
    a.attnotnull,a.attidentity,a.attgenerated,pg_catalog.pg_get_expr(d.adbin,d.adrelid)) order by a.attnum)
  into v_columns from pg_catalog.pg_attribute a left join pg_catalog.pg_attrdef d
    on d.adrelid=a.attrelid and d.adnum=a.attnum
  where a.attrelid=v_ledger and a.attnum>0 and not a.attisdropped;
  if v_columns is distinct from
    '[[1,"version","text",true,"","",null],[2,"name","text",true,"","",null],[3,"sha256","text",true,"","",null],[4,"applied_at","timestamp with time zone",true,"","","now()"]]'::jsonb
    or (select count(*) from pg_catalog.pg_constraint where conrelid=v_ledger)<>1
    or not exists(select 1 from pg_catalog.pg_constraint where conrelid=v_ledger
      and contype='p' and conkey=array[1]::smallint[] and convalidated and not condeferrable and not condeferred)
    or exists(select 1 from pg_catalog.pg_trigger where tgrelid=v_ledger and not tgisinternal)
    or exists(select 1 from pg_catalog.pg_rewrite where ev_class=v_ledger) then
    raise exception 'First-change exact ledger catalog unavailable' using errcode='55000';
  end if;
  perform 1 from supabase_migrations.schema_migrations where version='20260829063000' for update;
  if (select count(*) from supabase_migrations.schema_migrations
      where version='20260829063000'
      and name collate "C"='20260829063000_independent_admin_qualification_residue_retirement_gate.sql' collate "C"
      and sha256 collate "C"='4c958ca8af443e97f254fef1cfb1c2e6ea48f1907466d1b1c2ebc2282f598644' collate "C"
      and applied_at is not null)<>1
    or exists(select 1 from supabase_migrations.schema_migrations where version='20260831113000')
    or public.aistory_independent_admin_gate_status() is distinct from '20260829063000'
    or pg_catalog.to_regclass('public.independent_admin_password_state') is not null then
    raise exception 'First-change exact predecessor unavailable' using errcode='55000';
  end if;
end;
$first_change_ledger_preflight$;

\ir ../supabase/migrations/20260831113000_independent_admin_first_password_change_gate.sql

insert into supabase_migrations.schema_migrations(version,name,sha256) values(
  '20260831113000',
  '20260831113000_independent_admin_first_password_change_gate.sql',
  '3e3506bec1057aaef1bdbfa0b18d638ee5b95bd015afb3a9348aa6553101e61d'
);

do $first_change_ledger_postflight$
begin
  if (select count(*) from supabase_migrations.schema_migrations where version='20260831113000'
      and name collate "C"='20260831113000_independent_admin_first_password_change_gate.sql' collate "C"
      and sha256 collate "C"='3e3506bec1057aaef1bdbfa0b18d638ee5b95bd015afb3a9348aa6553101e61d' collate "C"
      and applied_at is not null)<>1
    or (select count(*) from supabase_migrations.schema_migrations where version='20260829063000'
      and name collate "C"='20260829063000_independent_admin_qualification_residue_retirement_gate.sql' collate "C"
      and sha256 collate "C"='4c958ca8af443e97f254fef1cfb1c2e6ea48f1907466d1b1c2ebc2282f598644' collate "C"
      and applied_at is not null)<>1
    or public.aistory_independent_admin_gate_status() is distinct from '20260829063000'
    or public.aistory_iap_first_change_posture() is distinct from '20260831113000' then
    raise exception 'First-change atomic domain ledger postflight unavailable' using errcode='55000';
  end if;
end;
$first_change_ledger_postflight$;
commit;
\echo PASS_FIRST_CHANGE_ATOMIC_LEDGER_APPLY
