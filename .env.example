# =============================================================
# InfiPlot — AI 实时交互剧情游戏
# Recommended setup: Xiaomi MiMo Token Plan for TEXT / VISION / TTS
# (one API key covers all three) + Runware for IMAGE (FLUX.2 [klein]).
#
# TEXT / VISION / IMAGE all speak the OpenAI wire format. Anthropic Claude
# and Google Gemini are reachable through their own OpenAI-compatible
# endpoints (see TEXT_PROVIDER notes below) — no native protocol switch is
# needed.
# TTS uses Xiaomi MiMo's own voice design / clone protocol
# (not OpenAI-compatible; appends -voicedesign / -voiceclone).
#
# IMAGE supports Runware (its own task-array protocol) and OpenAI (gpt-image)
# via IMAGE_PROVIDER.
#
# *_PROVIDER (optional) selects the wire protocol; leave unset for the
# OpenAI-compatible default (image is auto-detected from the URL). Valid
# values are openai_compatible / openai / runware — native "anthropic" /
# "google" protocols were removed when the Vercel AI SDK was dropped.
# Base URLs tolerate a missing or extra /v1 (or a trailing /chat/completions)
# — the engine normalizes them.
# =============================================================

# ---- 1. Text LLM · scene director ----------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Anthropic (via proxy),
# Gemini, OpenRouter, DeepSeek, OpenCode, MiMo, local Ollama, …
# Recommended starters:
#   A. DeepSeek v4-flash direct (https://api.deepseek.com/v1) — pay-as-you-go,
#      fastest first-token latency, very stable JSON output.
#   B. OpenCode Go (https://opencode.ai/zen/go/v1) — $10/mo flat-rate bundle of
#      12 open-source models (DeepSeek v4-flash, Qwen, Kimi, GLM, MiMo, …).
#      Cheaper at high volume, slower at the tail.
#   C. MiMo v2.5 via Xiaomi Token Plan — bundles VISION + TTS in one tp- key.
TEXT_BASE_URL=https://api.deepseek.com/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash
# TEXT_PROVIDER: openai_compatible (default). This is the ONLY supported text
# protocol. To use Gemini, leave TEXT_PROVIDER unset and point at its
# OpenAI-compatible endpoint:
#   Gemini  → TEXT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  TEXT_MODEL=gemini-3.5-flash
# For Claude, a compatible gateway (e.g. LiteLLM) is recommended — Anthropic's
# official endpoint offers an OpenAI-compatible layer but no caching, raising
# cost and latency for this app's prefix-cache-driven design.
# TEXT_PROVIDER=openai_compatible

# ---- 2. Image generator (renders the scene background) -------------
# Recommended: Runware + FLUX.2 [klein] 9B KV — distilled 4-step model,
# sub-second inference at ~$0.0008/image. Sign up at https://runware.ai
# AIR ids for FLUX.2 [klein] variants:
#   runware:400@1  · 4B (smaller)
#   runware:400@6  · 9B KV (recommended — fastest at 16:9)
IMAGE_BASE_URL=https://api.runware.ai/v1
IMAGE_API_KEY=
IMAGE_MODEL=runware:400@6
# IMAGE_PROVIDER: runware (auto-detected for runware.ai) | openai_compatible | openai
#   openai → gpt-image, supports referenceImages (character/scene continuity).
#            IMAGE_BASE_URL=https://api.openai.com  IMAGE_MODEL=gpt-image-1
# NOTE: openai returns raw bytes → inlined as a data: URI for the session
# (heavier per-call transport than Runware's UUID re-reference loop). Runware
# stays fastest + cheapest for the scene-by-scene flow.
# IMAGE_PROVIDER=runware

# Optional image-latency guards. BOTH default to OFF when unset — leaving
# them blank keeps the exact historical behavior, so self-hosted deploys are
# unaffected unless they opt in.
#   IMAGE_TIMEOUT_MS — per-attempt hard deadline for image requests; a timed
#     out attempt is retried like a 5xx. Recommended 30000 for Runware
#     (healthy-day p99 is ~26-37s; Runware's own gateway 504s at ~55s).
#   IMAGE_HEDGE_MS — scene-paint hedging: if the referenced scene paint has
#     not finished after this many ms, race a second identical request and
#     keep whichever finishes first (the loser is aborted, but the provider
#     may still bill it). Rescues straggler tasks; never fires when the first
#     attempt already failed (e.g. 429/503 saturation). Recommended 15000 for
#     Runware (healthy-day p95). Do NOT set thresholds this low for providers
#     that are normally slow (e.g. gpt-image takes 20-60s per image).
# IMAGE_TIMEOUT_MS=30000
# IMAGE_HEDGE_MS=15000

# ---- 3. Vision model · multimodal click interpretation -------------
# Recommended: MiMo V2.5 — multimodal, accepts image_url content parts.
VISION_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
VISION_API_KEY=
VISION_MODEL=mimo-v2.5
# VISION_PROVIDER: openai_compatible (default). Only openai_compatible is
# supported — reach Claude/Gemini via their OpenAI-compatible endpoints
# (same base URLs as TEXT above). Leave unset to use the default.
# VISION_PROVIDER=openai_compatible

# ---- 4. TTS (optional — leave blank to disable) --------------------
# Provider is auto-detected from TTS_BASE_URL host:
#   *stepfun.com  → StepFun (preset voices, keyword-scored selection)
#   otherwise     → Xiaomi MiMo (voicedesign + voiceclone)
#
# Xiaomi MiMo — per-character voice design → clone, with per-line delivery.
#   TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
#   TTS_API_KEY=tp-xxx
#   TTS_SPEECH_MODEL=mimo-v2.5-tts
#
# StepFun — 32 preset voices, auto-selected by gender + age + tone scoring.
#   TTS_BASE_URL=https://api.stepfun.com/v1
#   TTS_API_KEY=sk-xxx
#   TTS_SPEECH_MODEL=step-tts-mini          # or step-tts-2 / stepaudio-2.5-tts
TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
TTS_API_KEY=
TTS_SPEECH_MODEL=mimo-v2.5-tts

# ---- 5. MOCK_IMAGE — skip image generation (cheap TTS testing) -----
# true → return a placeholder image instead of calling the image model.
# Text/story/voice still run normally. Great for iterating on TTS.
MOCK_IMAGE=false

# ---- 5b. Image proxy (Cloudflare Worker, OPTIONAL) -----------------
# Leave NEXT_PUBLIC_IMAGE_PROXY_URL blank (the default) and the browser
# fetches images directly from the provider — exactly as the app worked
# before this proxy existed. The ALLOWED_HOSTS value below is inert until
# a proxy URL is set, so you're completely unaffected; skip this section.
#
# Why you might want it: Chrome's direct fetch of im.runware.ai is unreliable
# on some networks (ERR_QUIC_PROTOCOL_ERROR mid-stream → partial bytes →
# <img> paints progressively top-to-bottom). Routing the fetch through a tiny
# Cloudflare Worker re-fetches server-to-server (no QUIC fragility) and serves
# over HTTP/2 — atomic paint, plus edge caching + CORS.
#
# Deploy your own in ~1 min (one-click "Deploy to Cloudflare" button):
#   https://github.com/zonghaoyuan/infiplot-image-proxy
# Then paste the workers.dev URL it prints below. NEXT_PUBLIC_ vars are
# inlined at BUILD time — set them in Vercel/Cloudflare project settings.
NEXT_PUBLIC_IMAGE_PROXY_URL=
# Hostnames the proxy is allowed to fetch (comma-separated). Default covers
# Runware's CDN. If your IMAGE_BASE_URL points at another provider, add that
# provider's image host here so its URLs take the proxy path too. Anything
# not listed stays on the direct fetch. Only matters when the URL above is set.
NEXT_PUBLIC_IMAGE_PROXY_ALLOWED_HOSTS=im.runware.ai

# ---- 6. Analytics · Umami (optional — leave blank to disable) ------
# Privacy-friendly, cookieless page-view stats — no Cookie consent banner.
# Cloud: sign up at https://cloud.umami.is, add your site, copy its ID into
# NEXT_PUBLIC_UMAMI_WEBSITE_ID and use the cloud script URL:
#   NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# Self-host later: point SRC at your own instance — the integration is identical
# (no code change), e.g. NEXT_PUBLIC_UMAMI_SRC=https://stats.example.com/script.js
# Both blank → no script is injected (zero tracking; every track() call no-ops).
# Beyond page views the app emits content-free custom events (game start, scene
# reached, choice picked, ...) — only enums/counts/booleans, never your prompts,
# uploaded images or any per-user ID. The visitor's Do-Not-Track is honoured.
# NEXT_PUBLIC_ vars are inlined at BUILD time, so set them in the build env
# (Vercel project settings).
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional hostname allowlist — defense-in-depth on top of the blank-to-disable
# gate above. The tracker fires only when window.location.hostname EXACTLY
# matches an entry, so a fork that copied these vars stays silent on its own
# domain. Comma-separated, exact match: apex ≠ www (list both), no wildcards.
# Blank → track on all hosts. e.g. infiplot.com,www.infiplot.com
NEXT_PUBLIC_UMAMI_DOMAINS=

# ---- 7. Gallery share files ----
# Story share (`.infiplot` files) is always enabled — no secret needed.
# Files use SHA-256 integrity checks instead of encryption because the
# payload is AI-generated story content, not sensitive data.

# ---- 8. Auth · Supabase (optional — leave blank to disable) -------
# Sign up at https://supabase.com, create a project, copy the URL and
# publishable key (starts with sb_publishable_ or eyJ…).
# Both blank → Supabase Auth is disabled. This never grants administrator
# access, production phone identity, or formal credit access.
# NEXT_PUBLIC_ vars are inlined at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only origin override; never prefix this with NEXT_PUBLIC_.
AISTORY_SUPABASE_SERVER_URL=

# Administrator routes remain forbidden when Supabase auth is disabled.
# AUTH_ENABLED=false never grants administrator access.
#
# ---- 9. Super administrator control plane (server-only) ------------
# Local mode is OFF by default and accepts sessions only on localhost/127.0.0.1.
# Generate a random secret of at least 24 characters for one dev process. Never
# commit or expose it through NEXT_PUBLIC_*.
# AISTORY_LOCAL_ADMIN_ENABLED=false
# AISTORY_LOCAL_ADMIN_SECRET=
#
# Independent administrator principal v1 remains default-off. P0.4's
# local_fake_only value is evidence and must not be deployed. Production_v1
# additionally requires the exact independent feature DB gate and one HTTPS
# public origin. The credential file must live outside the checkout and be
# root/owner-only. Never place a username, password, salt, digest, binding hash,
# session key or credential contents in this template. Production_v1 also
# requires the existing trusted-proxy contract and mechanically rejects any
# enabled/configured loopback local-admin secret.
AISTORY_ADMIN_PRINCIPAL_MODE=
# AISTORY_ADMIN_PRINCIPAL_CREDENTIAL_FILE=
# AISTORY_ADMIN_PRINCIPAL_DATABASE_GATE_VERSION=
# AISTORY_ADMIN_PRINCIPAL_PUBLIC_ORIGIN=
#
# Repository defaults to the server-only local adapter (.aistory-admin,
# gitignored). Production identity/SMS/billing requires all four gate values
# below plus a service-role secret injected by the deployment secret manager.
# The gate version must exactly match the applied forward migration and the
# database-owned security-posture RPCs. Current expected version after the
# production video-asset metadata Gate14 migration: 20260811193000.
# Changing this env value does not apply or verify a migration by itself.
AISTORY_PRODUCTION_IDENTITY_ENABLED=false
AISTORY_IDENTITY_REPOSITORY=local
AISTORY_ADMIN_REPOSITORY=local
AISTORY_DATABASE_GATE_VERSION=
#
# Legacy Supabase Auth bootstrap remains isolated from ordinary phone sessions
# and from the independent administrator-principal candidate. Production use is
# separately controlled and these values must be removed immediately afterward.
# AISTORY_ADMIN_BOOTSTRAP_USER_ID=
# AISTORY_ADMIN_BOOTSTRAP_EMAIL=
#
# Explicit staging integration harness. It is zero-network unless enabled and
# accepts only an SSH-tunnel/loopback Supabase URL. Never reuse production
# credentials. The mutation check permanently appends one synthetic staging
# ledger/audit result and therefore has its own second opt-in switch.
# AISTORY_STAGING_INTEGRATION_ENABLED=false
# AISTORY_STAGING_SUPABASE_URL=
# AISTORY_STAGING_SUPABASE_SERVICE_ROLE_KEY=
# AISTORY_STAGING_ADMIN_ACTOR_ID=
# AISTORY_STAGING_TENANT_ID=platform
# AISTORY_STAGING_MUTATION_TEST_ENABLED=false
# AISTORY_STAGING_TEST_USER_ID=
# AISTORY_STAGING_TEST_RUN_ID=

# ---- 9.1 Platform-managed model credentials (server-only, OFF) -----
# Public early testing is BYOK-only. Enabling platform-managed credentials
# requires BOTH the kill switch and an authenticated user id allowlist entry.
# `anonymous` is always denied. Never expose these through NEXT_PUBLIC_*.
# AISTORY_PLATFORM_MANAGED_ENABLED=false
# AISTORY_PLATFORM_MANAGED_ALLOWLIST=
#
# Optional account-hosted BYOK vault. It is OFF until the forward migration is
# applied and mechanically verified, the Supabase repository is selected, a
# root-only KEK ring is injected by the deployment secret manager, a strict
# provider/origin/model allowlist is configured, and real phone OTP step-up is
# available. Browser-only BYOK is never migrated automatically.
AISTORY_HOSTED_BYOK_ENABLED=false
AISTORY_HOSTED_BYOK_REPOSITORY=disabled
AISTORY_HOSTED_BYOK_STEP_UP_ENABLED=false
# AISTORY_HOSTED_BYOK_STEP_UP_MAX_AGE_SECONDS=300
# Active version is non-secret metadata. The ring JSON is a server-only secret
# object whose values are base64-encoded 32-byte KEKs, for example versions v1
# and v2 during rotation. Do not put values in this file or NEXT_PUBLIC_*.
AISTORY_HOSTED_BYOK_ACTIVE_KEK_VERSION=
AISTORY_HOSTED_BYOK_KEK_RING_JSON=
# Non-secret JSON allowlist. Each entry fixes provider, capabilities, exact
# HTTPS origins and allowed models; arbitrary user endpoints are rejected.
AISTORY_HOSTED_BYOK_PROVIDER_ALLOWLIST_JSON=
#
# Formal platform-credit mode stays OFF until a versioned price policy exists.
# When enabled, anonymous cache hits remain available, but a cache miss that
# would spend platform money requires an authenticated account and reserves
# credits before the provider is called.
AISTORY_PLATFORM_BILLING_ENABLED=false
# Fixed beta pricing is a second, server-only gate. It never enables a provider.
# The version must equal the exact content-addressed policy row before quote.
AISTORY_PLATFORM_BILLING_POLICY_MODE=disabled
AISTORY_PLATFORM_BILLING_POLICY_VERSION=
#
# ---- 9.2 Phone verification (server-only, fail-closed) -------------
# Session, phone-identity and OTP secrets must each be independent random
# values of at least 32 characters. They are never NEXT_PUBLIC_* values.
# AISTORY_USER_SESSION_SECRET=
# AISTORY_PHONE_ID_PEPPER=
# AISTORY_SMS_OTP_SECRET=
# The anonymous subject values are independent, stable server secrets. They
# sign a high-entropy HttpOnly browser subject and store only its HMAC. Do not
# rotate the pepper without a dual-pepper identity-remap migration.
# AISTORY_ANONYMOUS_SESSION_SECRET=
# AISTORY_ANONYMOUS_SUBJECT_PEPPER=
# Optional public experiment assignment allowlist JSON. It contains no secret.
# AISTORY_PUBLIC_EXPERIMENT_ASSIGNMENTS_JSON=
#
# Set AISTORY_SMS_PROVIDER=aliyun_dysms only after RAM credentials, an approved
# signature, and an approved login template have been injected server-side.
# The adapter uses Dysmsapi 2017-05-25 SendSms through the official V2 SDK.
# Endpoint and region default to dysmsapi.aliyuncs.com and cn-hangzhou when the
# corresponding empty values below are omitted. Do not expose any of these as
# NEXT_PUBLIC_* variables.
# AISTORY_SMS_PROVIDER=
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIYUN_SMS_REGION=
# ALIYUN_SMS_ENDPOINT=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE_LOGIN=
# ALIYUN_SMS_TEMPLATE_PARAM_CODE_KEY=
# ALIYUN_SMS_CONNECT_TIMEOUT_MS=
# ALIYUN_SMS_READ_TIMEOUT_MS=
#
# Legacy deployment migration (not runtime aliases):
# SMS_SIGN_NAME -> ALIYUN_SMS_SIGN_NAME
# SMS_TEMPLATE_VERIFY -> ALIYUN_SMS_TEMPLATE_CODE_LOGIN
# SMS_FORCE_REAL is unsupported; use AISTORY_SMS_PROVIDER=aliyun_dysms.
#
# Local mock sends no SMS and is accepted only from an exact loopback
# Host/Origin pair.
# Trust forwarding headers only behind a controlled reverse proxy.
# AISTORY_TRUST_PROXY_HEADERS=false
# AISTORY_LOCAL_SMS_ENABLED=false
# AISTORY_LOCAL_SMS_TEST_CODE=

# ---- 9.3 AIUser OIDC readiness (server-only, validation only) ------
# Empty/missing stays DISABLED. The only current non-empty mode validates an
# explicitly supplied versioned adapter contract offline; it does not enable a
# callback, login, token exchange, session, membership, entitlement or credits.
# Never put issuer/client/callback/audience/credential values in this template.
AISTORY_AIUSER_OIDC_READINESS_MODE=

# Explicit AIUser-to-existing-phone association remains independently disabled.
# Admission additionally requires the exact sticky revocation selector below.
# Admission exact value: aistory-aiuser-explicit-account-link-v1:enabled
# Revocation exact value: aistory-aiuser-explicit-account-link-revocation-v1:enabled
# Stage revocation only after the DB gate, before admission; retain it while
# disabling/draining admission so logout stays serialized with older workers.
# Neither selector bypasses signed recent IdP auth_time, both current server
# sessions, the exact account-link DB gate/posture, or durable intents.
AISTORY_AIUSER_ACCOUNT_LINK_MODE=
AISTORY_AIUSER_ACCOUNT_LINK_REVOCATION_MODE=
AISTORY_AIUSER_LINKED_BILLING_MODE=

# ---- 10. Local production bridges (server-only, optional) ----------
# LocalMiniDrama is embedded inside the AIstory creator shell. P1 accepts
# loopback services only and fails closed when either side is unavailable.
# LOCAL_MINIDRAMA_BACKEND_URL=http://127.0.0.1:5679
# LOCAL_MINIDRAMA_FRONTEND_URL=http://127.0.0.1:4107
#
# ComfyUI is OFF by default. No request is made while disabled or while its
# workflow config is invalid. Each workflow value is a JSON wrapper containing
# {"workflow": <ComfyUI API JSON>, "outputNodeIds": [...], "bindings": {...}}.
# Node IDs, checkpoint, LoRA, ControlNet, reference-image/face bindings and
# video nodes are user configuration; AIstory does not hard-code a workflow.
# COMFYUI_ENABLED=false
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=
# COMFYUI_IMAGE_WORKFLOW_JSON=
# COMFYUI_VIDEO_WORKFLOW_JSON=
# COMFYUI_TIMEOUT_MS=5000
#
# Administrator video assets are fail-closed. Local development requires the
# explicit loopback adapter plus an absolute ffprobe path. Production requires
# every Gate14/Supabase/private OSS/ECS RAM Role value below. Credentials are
# obtained only from the explicit IMDSv2 ECS role; the SMS AK variables above
# are never an OSS credential source. `DEBUG` must not enable `ali-oss` (or a
# wildcard covering it), because the upstream SDK debug channel includes
# signed request headers. `NODE_TLS_REJECT_UNAUTHORIZED=0` is also rejected;
# missing or invalid values return 503.
# AISTORY_VIDEO_ASSET_ADAPTER=
# AISTORY_VIDEO_METADATA_REPOSITORY=
# AISTORY_VIDEO_ASSET_TENANT_ID=
# AISTORY_VIDEO_DATABASE_GATE_VERSION=
# AISTORY_VIDEO_FFPROBE_PATH=
# AISTORY_VIDEO_ASSET_DIR=
# AISTORY_VIDEO_MAX_UPLOAD_BYTES=
# AISTORY_VIDEO_OSS_BUCKET=
# AISTORY_VIDEO_OSS_REGION=
# AISTORY_VIDEO_OSS_INTERNAL_ENDPOINT=
# AISTORY_VIDEO_OSS_PREFIX=
# AISTORY_VIDEO_OSS_CREDENTIAL_SOURCE=
# AISTORY_VIDEO_OSS_ECS_RAM_ROLE_NAME=
# AISTORY_VIDEO_OSS_TIMEOUT_MS=
# AISTORY_VIDEO_IMDS_CONNECT_TIMEOUT_MS=
# AISTORY_VIDEO_IMDS_READ_TIMEOUT_MS=
# Interactive video story drafts/releases are also local-development-only.
# Production fails closed until a durable repository and object storage exist.
# AISTORY_VIDEO_STORY_ADAPTER=
# AISTORY_VIDEO_STORY_DIR=
#
# Local video workflow A/B packages are administrator-only and fail closed.
# The explicit local-development adapter stores canonical manifests, workflows,
# blind reviews and content-addressed outputs outside public/ in a gitignored
# directory. Package import also requires the absolute ffprobe path above.
# Production has no filesystem fallback.
# AISTORY_VIDEO_AB_ADAPTER=
# AISTORY_VIDEO_AB_DIR=
# AISTORY_VIDEO_AB_MAX_PACKAGE_BYTES=
#
# GPU Connector LAN LAB is an explicit local-lab bridge and is OFF by default.
# It accepts exactly one outbound-polling Connector, one 32+ byte HMAC secret,
# one durable gitignored store and only exact workflow id + SHA256 entries.
# Keep the allowlist empty until an operator explicitly selects a frozen LAB
# candidate. Current code accepts only reviewed LAN-LAB candidates and marks
# every result non-publishable; this is not a production workflow allowlist.
# The original 768x480 generation workflow and any later 720p upscale workflow
# must be separate exact id/SHA entries. Upscale reads a one-time sourceVideo
# ticket and creates a new artifact; it never changes the original workflow.
# The upload origin must be an operator-controlled HTTPS origin whose hostname
# exactly matches the route exposed to the Connector. No value is NEXT_PUBLIC_*.
# AISTORY_GPU_LAN_LAB_ENABLED=false
# AISTORY_GPU_LAN_LAB_CONNECTOR_ID=
# P1.7 Central accepts only one exact, operator-provided Connector attestation.
# These hashes are compared before a Connector session or repository write.
# AISTORY_GPU_LAN_LAB_EXPECTED_CONNECTOR_BUILD_SHA256=
# AISTORY_GPU_LAN_LAB_EXPECTED_CONNECTOR_RELEASE_SHA256=
# AISTORY_GPU_LAN_LAB_EXPECTED_CAPABILITY_DIGEST_SHA256=
# AISTORY_GPU_LAN_LAB_EXPECTED_CENTRAL_CONTRACT_SHA256=
# AISTORY_GPU_LAN_LAB_EXPECTED_RUNNER_MODE=no_work_only
# AISTORY_GPU_LAN_LAB_HMAC_KEY_ID=
# AISTORY_GPU_LAN_LAB_HMAC_SECRET_BASE64=
# AISTORY_GPU_LAN_LAB_STORE_DIR=
# AISTORY_GPU_LAN_LAB_COORDINATOR_ORIGIN=
# AISTORY_GPU_LAN_LAB_UPLOAD_ORIGIN=
# AISTORY_GPU_LAN_LAB_WORKFLOW_ALLOWLIST_JSON=
# AISTORY_GPU_LAN_LAB_MAX_VIDEO_BYTES=
# Connector-side posture declarations are independent and default false. They
# are names in the signed compatibility contract, not proof of remote network
# state; no_work acceptance requires production=false and LAN_LAB=true.
# AISTORY_CONNECTOR_ENABLE_PRODUCTION_NETWORK=false
# AISTORY_CONNECTOR_ENABLE_LAN_LAB_NETWORK=false

# ---- 11. Volcengine Agent Plan (server-only contract, OFF by default) --
# P1 declares per-modality routing and the official async video task contract,
# but deliberately ships without a production network transport. Enabling these
# values only marks the contract configured; it does not make a paid request.
# Agent Plan uses its own key and Base URL. Do not reuse Coding Plan keys.
# VOLCENGINE_AGENT_PLAN_ENABLED=false
# VOLCENGINE_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# VOLCENGINE_AGENT_PLAN_API_KEY=
# VOLCENGINE_AGENT_PLAN_VIDEO_MODEL=
# VOLCENGINE_AGENT_PLAN_TIMEOUT_MS=15000
# Product-provider routing is independent per modality. Automatic fallback is
# false in P1 so a manual selection never silently creates cross-provider cost.
# AISTORY_TEXT_PRODUCT_PROVIDER=bailian
# AISTORY_IMAGE_PRODUCT_PROVIDER=bailian
# AISTORY_TTS_PRODUCT_PROVIDER=bailian
