# Local review/executor artifacts and generated release evidence are not
# maintainable product source and may contain machine-specific paths.
/.tmp-doc-review/
/deepseek-tasks/
/deploy/
/release-evidence/
/qa/
/integration.patch
/*.obj

# Only the five manifest-approved public demo videos ship with the test kit.
/public/case-studies/*/assets/*.mp4
!/public/case-studies/world-model-anime-sunset/assets/demo.mp4
!/public/case-studies/world-model-close-encounter/assets/demo.mp4
!/public/case-studies/world-model-forest-friend/assets/demo.mp4
!/public/case-studies/world-model-little-chef/assets/demo.mp4
!/public/case-studies/world-model-midnight-heartbeat/assets/demo.mp4

# Guard against accidental recursive workspace copies.
/app/app/
/components/components/
/lib/lib/

# Vendored LocalMiniDrama source only; provider configuration and runtime
# databases must never enter the source snapshot.
/vendor/localminidrama/**/data/
/vendor/localminidrama/**/storage/
/vendor/localminidrama/**/configs/ai-configs*.json
/vendor/localminidrama/**/*.db*
/vendor/localminidrama/**/*.sqlite*
/vendor/localminidrama/**/.env*
/vendor/localminidrama/**/*.pem
/vendor/localminidrama/**/*.key

