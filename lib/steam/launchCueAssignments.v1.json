          "subtitle": {
            "kind": "include",
            "cueId": "slcc1-vg11-breakfast-choice-b5",
            "text": "男主，“好吃，你这个女友挺好的”",
            "textHash": "740dca38154cf0f0a9687068096390766b22c93df3757dc9b8f5628b13e38a6e"
          },
          "timing": { "kind": "range", "startMs": 20500, "endMs": 23500 }
