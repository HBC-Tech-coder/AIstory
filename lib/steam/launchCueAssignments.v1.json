          "speaker": { "kind": "narrator" },
          "audio": { "kind": "logical_slot", "slotId": "slca1-vg11-breakfast-choice-b3" },
          "subtitle": {
            "kind": "include",
            "cueId": "slcc1-vg11-breakfast-choice-b3",
            "text": "男主，边吃，边说：“你做得？好快”",
            "textHash": "2c2c9a60e41944ab45c6b81428ee5c49425deee7f898ba446cdf7eb12b83de2e"
          },
          "timing": { "kind": "range", "startMs": 7500, "endMs": 10500 }
